APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Папка с mysqldump для бэкапов: пусто на Linux (берётся из PATH), для OSPanel — C:/OSPanel/modules/MySQL-8.0/bin
DB_DUMP_BINARY_PATH=

# Правила пользования / оператор персональных данных (страница /rules)
LEGAL_OPERATOR="[наименование организации]"
LEGAL_ADDRESS="[адрес организации]"
LEGAL_CONTACT="администратор системы"

# Восстановление пароля по почте (без настроенной почты — false)
PASSWORD_RESET_EMAIL=false

# Резервные копии: второй носитель (флешка/сетевая папка) и проверочная база для пробного восстановления
BACKUP_EXTERNAL_PATH=
BACKUP_VERIFY_DATABASE=

# Автовыход при бездействии, минут (0 — выключен)
IDLE_LOGOUT_MINUTES=90
MAX_SESSION_HOURS=12
